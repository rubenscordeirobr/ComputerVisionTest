{
  // Paths are resolved relative to this file's directory (the repository root).
  "camerasFile": "./data/cameras.json",
  "modelPath": "./models/yolo26n.onnx",

  // "auto" = use CUDA when available, otherwise CPU. Can be forced to "cuda" or "cpu".
  "inferenceDevice": "auto",

  "detection": {
    // Minimum confidence for a detection to be drawn on the stream.
    "confidenceThreshold": 0.35,
    // Frames wider than this are downscaled before inference/publishing. 0 = full resolution.
    "maxProcessingWidth": 1280
  },

  "mediamtx": {
    // Annotated streams are published to {publishUrlBase}/{camera_name}.
    "publishUrlBase": "rtsp://localhost:8554/annotated"
  },

  "api": {
    // Cameras and capture rules are fetched from CameraVision.Api at startup;
    // finished recordings and camera status are reported back. When the API is
    // unreachable, cameras.json + the "recording" section below are used instead.
    "baseUrl": "http://localhost:5220",
    "apiKey": "cameravision-dev-key",
    "statusIntervalSeconds": 30
  },

  "recording": {
    // Object classes (COCO names) that trigger recording.
    "trackClasses": [ "person" ],
    // A track starts recording once it reaches this confidence at least once.
    "confidenceThreshold": 0.5,
    // Maximum duration of one clip; longer tracks produce consecutive clips + one merged video.
    "maxSegmentSeconds": 60,
    "outputRoot": "./output",
    // The object counts as "left the frame" after being unmatched for this long.
    "lostTrackTimeoutSeconds": 2.0
  }
}
