{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Storage": {
    "DatabasePath": "../../data/database.db",
    "OutputRoot": "../../output",
    "LegacyCamerasFile": "../../data/cameras.json"
  },
  "HealthCheck": {
    "IntervalSeconds": 15
  },
  "CaptureIndex": {
    "IntervalSeconds": 60
  }
}
