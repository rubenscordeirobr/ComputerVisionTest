@page "/users"
@attribute [Authorize(Policy = "Admin")]
@using CameraVision.Web.Components.Dialogs
@using CameraVision.Web.Services
@inject IUserRepository UserRepo
@inject ITenantRepository TenantRepo
@inject IDialogService DialogService

<PageTitle>Usuários — CameraVision</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Usuários</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="AddUserAsync">
        Novo usuário
    </MudButton>
</div>

<MudPaper>
    <MudTable Items="_users" Hover="true" Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>Usuário</MudTh>
            <MudTh>Nome</MudTh>
            @if (_isSuperAdmin)
            {
                <MudTh>Empresa</MudTh>
            }
            <MudTh>Perfil</MudTh>
            <MudTh>Ativo</MudTh>
            <MudTh>Criado em</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Usuário">@context.Username</MudTd>
            <MudTd DataLabel="Nome">@(context.DisplayName ?? "—")</MudTd>
            @if (_isSuperAdmin)
            {
                <MudTd DataLabel="Empresa">@TenantNameOf(context)</MudTd>
            }
            <MudTd DataLabel="Perfil">
                @if (context.Role == UserRole.User)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">@RoleUi.Label(context.Role)</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                             Color="@(context.Role == UserRole.SuperAdmin ? Color.Warning : Color.Primary)">
                        @RoleUi.Label(context.Role)
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Ativo">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                         Color="@(context.IsActive ? Color.Success : Color.Default)">
                    @(context.IsActive ? "Ativo" : "Desativado")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Criado em">@context.CreatedAt.ToString("dd/MM/yyyy HH:mm")</MudTd>
            <MudTd Style="text-align:right; white-space: nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => EditUserAsync(context))" aria-label="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Key" Size="Size.Small"
                               OnClick="@(() => ResetPasswordAsync(context))" aria-label="Redefinir senha" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<AppUser> _users = [];
    private IReadOnlyList<Tenant> _tenants = [];
    private Dictionary<int, string> _tenantNames = [];
    private bool _loading = true;
    private bool _isSuperAdmin;
    private int? _tenantFilter;
    private int? _editorTenantId;
    private int _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        _currentUserId = auth.User.GetUserId();
        _isSuperAdmin = auth.User.IsSuperAdmin();
        _tenantFilter = auth.User.GetTenantFilter();
        _editorTenantId = auth.User.GetTenantId();

        if (_isSuperAdmin)
        {
            _tenants = await TenantRepo.GetAllAsync();
            _tenantNames = _tenants.ToDictionary(t => t.Id, t => t.Name);
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _users = await UserRepo.GetAllAsync(_tenantFilter);
        _loading = false;
    }

    private string TenantNameOf(AppUser user) =>
        user.TenantId is { } tenantId ? _tenantNames.GetValueOrDefault(tenantId, "—") : "—";

    private async Task AddUserAsync()
    {
        var parameters = new DialogParameters<UserDialog>
        {
            { d => d.User, new AppUser { TenantId = _editorTenantId } },
            { d => d.IsNew, true },
            { d => d.CurrentUserId, _currentUserId },
            { d => d.EditorIsSuperAdmin, _isSuperAdmin },
            { d => d.EditorTenantId, _editorTenantId },
            { d => d.Tenants, _tenants },
        };
        var dialog = await DialogService.ShowAsync<UserDialog>("Novo usuário", parameters, DialogOpts);
        if ((await dialog.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task EditUserAsync(AppUser user)
    {
        var copy = new AppUser
        {
            Id = user.Id,
            TenantId = user.TenantId,
            Username = user.Username,
            DisplayName = user.DisplayName,
            PasswordHash = user.PasswordHash,
            Role = user.Role,
            IsActive = user.IsActive,
            CreatedAt = user.CreatedAt,
        };
        var parameters = new DialogParameters<UserDialog>
        {
            { d => d.User, copy },
            { d => d.IsNew, false },
            { d => d.CurrentUserId, _currentUserId },
            { d => d.EditorIsSuperAdmin, _isSuperAdmin },
            { d => d.EditorTenantId, _editorTenantId },
            { d => d.Tenants, _tenants },
        };
        var dialog = await DialogService.ShowAsync<UserDialog>("Editar usuário", parameters, DialogOpts);
        if ((await dialog.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task ResetPasswordAsync(AppUser user)
    {
        var parameters = new DialogParameters<ResetPasswordDialog> { { d => d.User, user } };
        await DialogService.ShowAsync<ResetPasswordDialog>(
            $"Redefinir senha — {user.Username}", parameters, DialogOpts);
    }

    private static readonly DialogOptions DialogOpts = new() { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true };
}
