@page "/capture-settings"
@using CameraVision.Web.Components.Dialogs
@using CameraVision.Core.Alerts
@inject ICaptureRuleRepository RuleRepo
@inject TemporaryNoticeService Notices
@inject IContactRepository ContactRepo
@inject ITenantRepository TenantRepo
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Regras de Captura — CameraVision</PageTitle>

<div class="d-flex align-center mb-4 flex-wrap gap-2">
    <MudText Typo="Typo.h4">Regras de Captura</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Disabled="@(_rules.Count == 0)"
               StartIcon="@Icons.Material.Filled.NotificationAdd" OnClick="AddTemporaryNoticeAsync">
        Aviso temporário
    </MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="AddRuleAsync">
        Nova regra
    </MudButton>
</div>

<MudAlert Severity="Severity.Info" Class="mb-4" Style="max-width: 1000px;">
    Cada regra define quais objetos são gravados, quem é avisado e quando (Notificações) e o
    antiflood das notificações — por exemplo, "pessoa → WhatsApp à noite" e "gato → e-mail sempre".
    O processador de detecção aplica a união das regras ativas.
</MudAlert>

@if (_runningTemporary > 0)
{
    <MudAlert Severity="Severity.Warning" Class="mb-4" Style="max-width: 1000px;">
        <div class="d-flex align-center flex-wrap gap-3">
            <span>Aviso temporário ativo em @_runningTemporary regra(s).</span>
            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning"
                       OnClick="EndAllTemporaryAsync">
                Encerrar todos
            </MudButton>
        </div>
    </MudAlert>
}

<MudPaper>
    <MudTable Items="_rules" Hover="true" Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            @if (_isSuperAdmin)
            {
                <MudTh>Cliente</MudTh>
            }
            <MudTh>Classes</MudTh>
            <MudTh>Confiança</MudTh>
            <MudTh>Segmento</MudTh>
            <MudTh>Espera</MudTh>
            <MudTh>Grava em</MudTh>
            <MudTh>Notificações</MudTh>
            <MudTh>Antiflood</MudTh>
            <MudTh>Ativa</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nome">@context.Name</MudTd>
            @if (_isSuperAdmin)
            {
                <MudTd DataLabel="Cliente">@TenantNameOf(context.TenantId)</MudTd>
            }
            <MudTd DataLabel="Classes">
                @foreach (var className in context.Classes)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Text">
                        @DetectableClasses.Translate(className)
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Confiança">@context.ConfidenceThreshold.ToString("P0")</MudTd>
            <MudTd DataLabel="Segmento">@($"{context.MaxSegmentSeconds} s")</MudTd>
            <MudTd DataLabel="Espera">@($"{context.LingerSeconds:0.#} s")</MudTd>
            <MudTd DataLabel="Grava em">
                @if (context.IsAlwaysActive)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Sempre</MudText>
                }
                else
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text">
                        @($"{context.ActiveFrom:HH\\:mm}–{context.ActiveTo:HH\\:mm}")
                    </MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Notificações" Style="white-space: nowrap;">
                @if (context.Triggers.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                }
                @foreach (var channel in ChannelUi.All)
                {
                    var ofChannel = context.Triggers.Where(t => t.Channel == channel).ToList();
                    if (ofChannel.Count == 0)
                        continue;
                    var active = ofChannel.Count(t => t.Enabled && !t.IsExpiredAt(_now));
                    <MudTooltip>
                        <ChildContent>
                            <MudBadge Content="@active" Color="@ChannelUi.ChannelColor(channel)" Overlap="true"
                                      Visible="@(active > 0)" Class="mr-3">
                                <MudIcon Icon="@ChannelUi.Icon(channel)" Size="Size.Small"
                                         Color="@(active > 0 ? ChannelUi.ChannelColor(channel) : Color.Default)" />
                            </MudBadge>
                        </ChildContent>
                        <TooltipContent>
                            @foreach (var trigger in ofChannel)
                            {
                                <div>@TriggerText.Summary(trigger, _contactsById, _now)</div>
                            }
                        </TooltipContent>
                    </MudTooltip>
                }
                @foreach (var trigger in context.Triggers.Where(t => TriggerText.IsRunningTemporary(t, _now)))
                {
                    <MudTooltip Text="@($"{TriggerText.Schedule(trigger, _now)} · {TriggerText.Contacts(trigger, _contactsById)} — clique no X para encerrar")">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled"
                                 Icon="@Icons.Material.Filled.Timer" OnClose="@(() => EndTemporaryAsync(trigger))">
                            Temporário · @ChannelUi.Label(trigger.Channel)
                        </MudChip>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="Antiflood">@TriggerText.Window(context.GroupWindowMinutes)</MudTd>
            <MudTd DataLabel="Ativa">
                <MudSwitch T="bool" Value="context.Enabled" Color="Color.Success"
                           ValueChanged="@((bool value) => ToggleEnabledAsync(context, value))" />
            </MudTd>
            <MudTd Style="text-align:right; white-space: nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => EditRuleAsync(context))" aria-label="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteRuleAsync(context))" aria-label="Excluir" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="mud-text-secondary">Nenhuma regra cadastrada.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<CaptureRule> _rules = [];
    private IReadOnlyList<Tenant> _tenants = [];
    private Dictionary<int, string> _tenantNames = [];
    private IReadOnlyList<Contact> _contacts = [];
    private Dictionary<int, Contact> _contactsById = [];
    private bool _loading = true;
    private bool _isSuperAdmin;
    private int? _tenantFilter;
    private int? _ownTenantId;
    private DateTime _now = DateTime.Now;
    private int _runningTemporary;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        _isSuperAdmin = auth.User.IsSuperAdmin();
        _tenantFilter = auth.User.GetTenantFilter();
        _ownTenantId = auth.User.GetTenantId();
        if (_isSuperAdmin)
        {
            _tenants = await TenantRepo.GetAllAsync();
            _tenantNames = _tenants.ToDictionary(t => t.Id, t => t.Name);
        }
        await LoadAsync();
    }

    private string TenantNameOf(int tenantId) => _tenantNames.GetValueOrDefault(tenantId, "—");

    private async Task LoadAsync()
    {
        _loading = true;
        _rules = await RuleRepo.GetAllAsync(_tenantFilter);
        _contacts = await ContactRepo.GetAllAsync(_tenantFilter);
        _contactsById = _contacts.ToDictionary(c => c.Id);
        _now = DateTime.Now;
        _runningTemporary = _rules.Count(r => r.Triggers.Any(t => TriggerText.IsRunningTemporary(t, _now)));
        _loading = false;
    }

    private async Task ToggleEnabledAsync(CaptureRule rule, bool enabled)
    {
        rule.Enabled = enabled;
        await RuleRepo.UpdateAsync(rule); // scalars only — the rule's notifications are untouched
    }

    private async Task AddRuleAsync()
    {
        var rule = new CaptureRule
        {
            TenantId = _isSuperAdmin ? _tenants.FirstOrDefault()?.Id ?? 0 : _ownTenantId ?? 0,
        };
        await OpenRuleDialogAsync("Nova regra", rule);
    }

    private async Task EditRuleAsync(CaptureRule rule) =>
        await OpenRuleDialogAsync("Editar regra", CaptureRuleClones.Clone(rule));

    private async Task OpenRuleDialogAsync(string title, CaptureRule rule)
    {
        var parameters = new DialogParameters<CaptureRuleDialog>
        {
            { d => d.Rule, rule },
            { d => d.ShowTenantSelect, _isSuperAdmin },
            { d => d.Tenants, _tenants },
        };
        var dialog = await DialogService.ShowAsync<CaptureRuleDialog>(title, parameters, DialogOpts);
        if ((await dialog.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task DeleteRuleAsync(CaptureRule rule)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir regra",
            $"Excluir a regra \"{rule.Name}\"? Objetos dela deixam de ser gravados/alertados.",
            yesText: "Excluir", cancelText: "Cancelar");
        if (confirmed == true)
        {
            await RuleRepo.DeleteAsync(rule.Id);
            Snackbar.Add("Regra excluída.", Severity.Success);
            await LoadAsync();
        }
    }

    private async Task AddTemporaryNoticeAsync()
    {
        var parameters = new DialogParameters<TemporaryNoticeDialog>
        {
            { d => d.Contacts, _contacts },
            { d => d.Rules, _rules },
            { d => d.ShowTenantSelect, _isSuperAdmin },
            { d => d.Tenants, _tenants },
            { d => d.TenantId, _isSuperAdmin ? _tenants.FirstOrDefault()?.Id ?? 0 : _ownTenantId ?? 0 },
        };
        var dialog = await DialogService.ShowAsync<TemporaryNoticeDialog>("Aviso temporário", parameters, TemporaryDialogOpts);
        if ((await dialog.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task EndTemporaryAsync(AlertTrigger trigger)
    {
        await RuleRepo.DeleteTriggersAsync([trigger.Id]);
        Snackbar.Add("Aviso temporário encerrado.", Severity.Success);
        await LoadAsync();
    }

    private async Task EndAllTemporaryAsync()
    {
        await Notices.EndAllRunningAsync(_rules, DateTime.Now);
        Snackbar.Add("Avisos temporários encerrados.", Severity.Success);
        await LoadAsync();
    }

    private static readonly DialogOptions DialogOpts = new() { MaxWidth = MaxWidth.Medium, FullWidth = true };
    private static readonly DialogOptions TemporaryDialogOpts = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
}
