@page "/cameras"
@using CameraVision.Core.Health
@using CameraVision.Web.Components.Dialogs
@using CameraVision.Web.Services
@implements IDisposable
@inject ICameraRepository CameraRepo
@inject ITenantRepository TenantRepo
@inject ICameraHealthService Health
@inject IWorkerHealthService WorkerHealthService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Câmeras — CameraVision</PageTitle>

<div class="d-flex align-center mb-4">
    <MudText Typo="Typo.h4">Câmeras</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add" OnClick="AddCameraAsync">
        Nova câmera
    </MudButton>
</div>

@if (WorkerBannerText() is { } bannerText)
{
    <MudAlert Severity="Severity.Error" Class="mb-4" Icon="@Icons.Material.Filled.ReportProblem">
        <b>Processador de vídeo parado.</b> @bannerText Nenhuma detecção está sendo processada ou gravada.
    </MudAlert>
}

<MudPaper>
    <MudTable Items="_cameras" Hover="true" Loading="_loading" LoadingProgressColor="Color.Primary">
        <HeaderContent>
            <MudTh>Nome</MudTh>
            @if (_isSuperAdmin)
            {
                <MudTh>Cliente</MudTh>
            }
            <MudTh>Stream</MudTh>
            <MudTh>IP</MudTh>
            <MudTh>Ativa</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Latência</MudTh>
            <MudTh>Processador</MudTh>
            <MudTh Style="text-align:right">Ações</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Nome">@context.Name</MudTd>
            @if (_isSuperAdmin)
            {
                <MudTd DataLabel="Cliente">@TenantNameOf(context.TenantId)</MudTd>
            }
            <MudTd DataLabel="Stream">
                @if (string.IsNullOrWhiteSpace(context.StreamUrl))
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                }
                else
                {
                    <MudTooltip Text="@context.StreamUrl">
                        <MudText Typo="Typo.body2">@Truncate(context.StreamUrl, 45)</MudText>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd DataLabel="IP">@(context.IpAddress ?? "—")</MudTd>
            <MudTd DataLabel="Ativa">
                <MudSwitch T="bool" Value="context.Enabled" Color="Color.Success"
                           ValueChanged="@((bool value) => ToggleEnabledAsync(context, value))" />
            </MudTd>
            <MudTd DataLabel="Status">
                @{ var (label, color, tooltip) = StatusFor(context); }
                @if (tooltip != null)
                {
                    <MudTooltip Text="@tooltip">
                        <MudChip T="string" Color="@color" Size="Size.Small" Variant="Variant.Filled">@label</MudChip>
                    </MudTooltip>
                }
                else
                {
                    <MudChip T="string" Color="@color" Size="Size.Small" Variant="Variant.Filled">@label</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Latência">@LatencyFor(context)</MudTd>
            <MudTd DataLabel="Processador">
                @{ var (procLabel, procColor) = ProcessorFor(context); }
                @if (procLabel == "—")
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">—</MudText>
                }
                else
                {
                    <MudTooltip Text="@ProcessorTooltip(context)">
                        <MudChip T="string" Color="@procColor" Size="Size.Small" Variant="Variant.Text">@procLabel</MudChip>
                    </MudTooltip>
                }
            </MudTd>
            <MudTd Style="text-align:right; white-space: nowrap;">
                <MudIconButton Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Small" Color="Color.Primary"
                               Disabled="@(!CanWatchLive(context))"
                               OnClick="@(() => WatchLiveAsync(context))" aria-label="Ver ao vivo" />
                <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small"
                               OnClick="@(() => ShowHistoryAsync(context))" aria-label="Histórico de saúde" />
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               OnClick="@(() => EditCameraAsync(context))" aria-label="Editar" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                               OnClick="@(() => DeleteCameraAsync(context))" aria-label="Excluir" />
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="mud-text-secondary">Nenhuma câmera cadastrada.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

@code {
    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = default!;

    private IReadOnlyList<Camera> _cameras = [];
    private IReadOnlyList<Tenant> _tenants = [];
    private Dictionary<int, string> _tenantNames = [];
    private bool _loading = true;
    private bool _isSuperAdmin;
    private int? _tenantFilter;
    private int? _ownTenantId;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState;
        _isSuperAdmin = auth.User.IsSuperAdmin();
        _tenantFilter = auth.User.GetTenantFilter();
        _ownTenantId = auth.User.GetTenantId();
        if (_isSuperAdmin)
        {
            _tenants = await TenantRepo.GetAllAsync();
            _tenantNames = _tenants.ToDictionary(t => t.Id, t => t.Name);
        }

        Health.Changed += OnHealthChanged;
        WorkerHealthService.Changed += OnHealthChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Health.Changed -= OnHealthChanged;
        WorkerHealthService.Changed -= OnHealthChanged;
    }

    // Reload on every probe cycle so ProcessorStatusAt (written by the API when the
    // worker reports) stays fresh — staleness verdicts depend on it.
    private void OnHealthChanged() => _ = InvokeAsync(async () =>
    {
        _cameras = await CameraRepo.GetAllAsync(_tenantFilter);
        StateHasChanged();
    });

    private async Task LoadAsync()
    {
        _loading = true;
        _cameras = await CameraRepo.GetAllAsync(_tenantFilter);
        _loading = false;
    }

    private string TenantNameOf(int tenantId) => _tenantNames.GetValueOrDefault(tenantId, "—");

    private string? WorkerBannerText()
    {
        if (_cameras.Count == 0 || WorkerHealthService.Current is not { IsStale: true } snapshot)
            return null;
        return snapshot.LastSeenAt is { } seen
            ? $"Última atualização às {seen:HH:mm:ss} ({TimeText.Ago(seen, DateTime.Now)})."
            : "O processador nunca se conectou.";
    }

    private (string Label, Color Color, string? Tooltip) StatusFor(Camera camera)
    {
        if (!camera.Enabled)
            return ("Desativada", Color.Default, null);
        if (string.IsNullOrWhiteSpace(camera.StreamUrl) && string.IsNullOrWhiteSpace(camera.IpAddress))
            return ("Sem stream", Color.Default, null);

        var probe = Health.TryGet(camera.Id)?.Status;
        if (probe == CameraStatus.Offline)
            return ("Offline", Color.Error, null);
        if (probe != CameraStatus.Online)
            return ("Verificando…", Color.Default, null);

        // The camera answers, but "Online" also requires the worker to keep its
        // status fresh — otherwise nothing is actually processing the stream.
        if (WorkerHealth.IsStale(camera.ProcessorStatusAt, DateTime.Now))
        {
            var since = camera.ProcessorStatusAt is { } at
                ? $"sem atualização desde {at:dd/MM HH:mm:ss}"
                : "esta câmera nunca foi processada";
            return ("Sem processamento", Color.Warning,
                $"Câmera acessível, mas o processador de vídeo não está atualizando o status ({since}). " +
                "Verifique se o CameraVision.DetectionWorker está em execução.");
        }

        return ("Online", Color.Success, null);
    }

    private static (string Label, Color Color) ProcessorFor(Camera camera)
    {
        if (camera.ProcessorStatusAt == null)
            return ("—", Color.Default);
        if (WorkerHealth.IsStale(camera.ProcessorStatusAt, DateTime.Now))
            return ("Sem resposta", Color.Error);
        return camera.ProcessorStatus switch
        {
            "connected" => ("Conectado", Color.Success),
            "reconnecting" => ("Reconectando", Color.Warning),
            "stopped" => ("Parado", Color.Default),
            _ => ("—", Color.Default),
        };
    }

    private static string ProcessorTooltip(Camera camera) =>
        $"Última atualização do processador: {camera.ProcessorStatusAt:dd/MM/yyyy HH:mm:ss}";

    private string LatencyFor(Camera camera)
    {
        var health = Health.TryGet(camera.Id);
        if (!camera.Enabled || health is null)
            return "—";
        var ms = health.PingMs ?? health.ConnectMs;
        return ms is null ? "—" : $"{ms} ms";
    }

    private static string Truncate(string value, int max) =>
        value.Length <= max ? value : value[..max] + "…";

    private async Task ToggleEnabledAsync(Camera camera, bool enabled)
    {
        camera.Enabled = enabled;
        await CameraRepo.UpdateAsync(camera);
    }

    private async Task AddCameraAsync()
    {
        var camera = new Camera
        {
            TenantId = _isSuperAdmin ? _tenants.FirstOrDefault()?.Id ?? 0 : _ownTenantId ?? 0,
        };
        var parameters = new DialogParameters<CameraDialog>
        {
            { d => d.Camera, camera },
            { d => d.ShowTenantSelect, _isSuperAdmin },
            { d => d.Tenants, _tenants },
        };
        var dialog = await DialogService.ShowAsync<CameraDialog>("Nova câmera", parameters, DialogOpts);
        if ((await dialog.Result) is { Canceled: false })
            await LoadAsync();
    }

    private async Task EditCameraAsync(Camera camera)
    {
        var copy = new Camera
        {
            Id = camera.Id,
            TenantId = camera.TenantId,
            Name = camera.Name,
            StreamUrl = camera.StreamUrl,
            SubStreamUrl = camera.SubStreamUrl,
            PreferredStream = camera.PreferredStream,
            IpAddress = camera.IpAddress,
            Enabled = camera.Enabled,
            CreatedAt = camera.CreatedAt,
            ProcessorStatus = camera.ProcessorStatus,
            ProcessorStatusAt = camera.ProcessorStatusAt,
        };
        var parameters = new DialogParameters<CameraDialog>
        {
            { d => d.Camera, copy },
            { d => d.ShowTenantSelect, _isSuperAdmin },
            { d => d.Tenants, _tenants },
        };
        var dialog = await DialogService.ShowAsync<CameraDialog>("Editar câmera", parameters, DialogOpts);
        if ((await dialog.Result) is { Canceled: false })
            await LoadAsync();
    }

    private static bool CanWatchLive(Camera camera) =>
        camera.Enabled && !string.IsNullOrWhiteSpace(camera.StreamUrl);

    private async Task WatchLiveAsync(Camera camera)
    {
        var parameters = new DialogParameters<LiveViewDialog> { { d => d.Camera, camera } };
        await DialogService.ShowAsync<LiveViewDialog>(
            $"Ao vivo — {camera.Name}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true });
    }

    private async Task ShowHistoryAsync(Camera camera)
    {
        var parameters = new DialogParameters<CameraHealthHistoryDialog> { { d => d.Camera, camera } };
        await DialogService.ShowAsync<CameraHealthHistoryDialog>(
            $"Histórico de saúde — {camera.Name}", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true });
    }

    private async Task DeleteCameraAsync(Camera camera)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Excluir câmera",
            $"Excluir a câmera \"{camera.Name}\"? As capturas já gravadas serão mantidas.",
            yesText: "Excluir", cancelText: "Cancelar");
        if (confirmed == true)
        {
            await CameraRepo.DeleteAsync(camera.Id);
            Snackbar.Add("Câmera excluída.", Severity.Success);
            await LoadAsync();
        }
    }

    private static readonly DialogOptions DialogOpts = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
}
