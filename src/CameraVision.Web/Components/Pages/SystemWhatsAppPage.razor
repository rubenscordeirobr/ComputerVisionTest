@page "/system/whatsapp"
@attribute [Authorize(Policy = "SuperAdmin")]
@using CameraVision.Web.Components.Dialogs
@implements IDisposable
@inject ISettingsRepository SettingsRepo
@inject IEvolutionApiClient Evolution
@inject IWhatsAppCommandRepository CommandRepo
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>Sistema · WhatsApp — CameraVision</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">WhatsApp (Evolution API)</MudText>

<MudPaper Class="pa-6 mb-4" Style="max-width: 800px;">
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="_settings.EvolutionBaseUrl" Label="URL base"
                          Placeholder="http://localhost:8080"
                          Validation="@(new Func<string, string?>(SettingsValidation.OptionalUrl))" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="_settings.EvolutionApiKey" Label="API Key"
                          InputType="@(_showApiKey ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showApiKey ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showApiKey = !_showApiKey)" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudTextField T="string" @bind-Value="_settings.EvolutionInstanceName" Label="Nome da instância" />
        </MudItem>
    </MudGrid>
    <div class="d-flex justify-end mt-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Salvar</MudButton>
    </div>

    <MudDivider Class="my-4" />

    <div class="d-flex align-center gap-3 mb-3">
        <MudText Typo="Typo.subtitle1">Pareamento do WhatsApp</MudText>
        @{ var (stateLabel, stateColor) = ConnectionChip(); }
        <MudChip T="string" Color="@stateColor" Size="Size.Small" Variant="Variant.Filled">@stateLabel</MudChip>
    </div>

    <div class="d-flex gap-2 mb-3">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(!EvolutionConfigured || _pairing)"
                   StartIcon="@Icons.Material.Filled.QrCode2" OnClick="GenerateQrAsync">
            @(_qr == null ? "Gerar QR Code" : "Atualizar QR")
        </MudButton>
        <MudButton Variant="Variant.Outlined" Color="Color.Success" Disabled="@(!EvolutionConfigured)"
                   StartIcon="@Icons.Material.Filled.Send" OnClick="OpenTestDialogAsync">
            Enviar mensagem de teste
        </MudButton>
    </div>

    @if (!EvolutionConfigured)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Preencha e salve a URL base e o nome da instância para gerar o QR Code.
        </MudText>
    }

    @if (_pairError != null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-3">@_pairError</MudAlert>
    }

    @if (_connection == EvolutionConnection.Open)
    {
        <MudAlert Severity="Severity.Success">WhatsApp conectado com sucesso.</MudAlert>
    }
    else if (_qr != null)
    {
        <div class="d-flex flex-column align-start gap-2">
            @if (_qr.Base64Image != null)
            {
                <img src="@_qr.Base64Image" alt="QR Code do WhatsApp"
                     style="width: 260px; height: 260px; image-rendering: pixelated;" />
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    Abra o WhatsApp → Dispositivos conectados → Conectar dispositivo e leia o QR.
                    O código é renovado automaticamente a cada 40 segundos.
                </MudText>
            }
            @if (_qr.PairingCode != null)
            {
                <MudText Typo="Typo.body1">Código de pareamento: <b>@_qr.PairingCode</b></MudText>
            }
        </div>
    }
</MudPaper>

<MudPaper Class="pa-6 mb-4" Style="max-width: 800px;">
    <div class="d-flex align-center gap-3 mb-2">
        <MudText Typo="Typo.subtitle1">Agente de comandos</MudText>
        @{ var (webhookLabel, webhookColor) = WebhookChip(); }
        <MudChip T="string" Color="@webhookColor" Size="Size.Small" Variant="Variant.Filled">@webhookLabel</MudChip>
    </div>
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
        Contatos cadastrados podem mandar "ativar alertas" ou "desativar alertas" para o número
        pareado: o agente cria ou encerra um aviso temporário no próprio número do remetente e
        responde. A Evolution API entrega as mensagens recebidas no webhook abaixo (registrado na
        instância); o modelo de IA opcional fica em <MudLink Href="/system/ai">Inteligência artificial</MudLink>.
    </MudText>
    <MudGrid Spacing="2">
        <MudItem xs="12" sm="6">
            <MudSwitch T="bool" @bind-Value="_settings.WhatsAppBotEnabled" Color="Color.Success" Label="Agente ativado" />
        </MudItem>
        <MudItem xs="12" sm="6">
            <MudNumericField T="int" @bind-Value="_settings.WhatsAppBotDefaultHours" Label="Duração padrão (horas)"
                             Min="1" Max="72" HelperText="Quando o remetente não diz até quando" />
        </MudItem>
        <MudItem xs="12">
            <MudTextField T="string" @bind-Value="_settings.WhatsAppWebhookUrl" Label="URL do webhook (vista pela Evolution API)"
                          Validation="@(new Func<string, string?>(SettingsValidation.OptionalUrl))"
                          HelperText="Padrão: http://host.docker.internal:5220/api/whatsapp/webhook (API deste host, a partir do Docker)" />
        </MudItem>
        <MudItem xs="12" sm="8">
            <MudTextField T="string" @bind-Value="_settings.WhatsAppWebhookSecret" Label="Segredo do webhook"
                          InputType="@(_showSecret ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showSecret ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="@(() => _showSecret = !_showSecret)" />
        </MudItem>
        <MudItem xs="12" sm="4" Class="d-flex align-center">
            <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Autorenew"
                       OnClick="GenerateSecret">Gerar segredo</MudButton>
        </MudItem>
    </MudGrid>
    <div class="d-flex justify-end gap-2 mt-4 flex-wrap">
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Disabled="@(!EvolutionConfigured || _registering)"
                   StartIcon="@Icons.Material.Filled.Webhook" OnClick="RegisterWebhookAsync">
            Registrar webhook
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">Salvar</MudButton>
    </div>
    @if (_webhookError != null)
    {
        <MudAlert Severity="Severity.Error" Class="mt-3">@_webhookError</MudAlert>
    }

    <MudDivider Class="my-4" />

    <div class="d-flex align-center gap-2 mb-2">
        <MudText Typo="Typo.subtitle2">Últimas mensagens recebidas</MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="LoadCommandsAsync" aria-label="Atualizar" />
    </div>
    <MudTable Items="_commands" Dense="true" Hover="true" Elevation="0">
        <HeaderContent>
            <MudTh>Quando</MudTh>
            <MudTh>Remetente</MudTh>
            <MudTh>Mensagem</MudTh>
            <MudTh>Intenção</MudTh>
            <MudTh>Status</MudTh>
            <MudTh>Detalhe</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Quando" Style="white-space: nowrap;">@context.ReceivedAt.ToString("dd/MM HH:mm")</MudTd>
            <MudTd DataLabel="Remetente" Style="white-space: nowrap;">
                @(context.PushName ?? context.SenderNumber)
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.SenderNumber</MudText>
            </MudTd>
            <MudTd DataLabel="Mensagem">@context.Text</MudTd>
            <MudTd DataLabel="Intenção" Style="white-space: nowrap;">
                @CommandReplyText.IntentLabel(context.Intent)
                @if (context.IntentSource != null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@CommandReplyText.SourceLabel(context.IntentSource)</MudText>
                }
            </MudTd>
            <MudTd DataLabel="Status">
                @{ var (statusLabel, statusColor) = StatusChip(context.Status); }
                <MudChip T="string" Size="Size.Small" Color="@statusColor" Variant="Variant.Text">@statusLabel</MudChip>
            </MudTd>
            <MudTd DataLabel="Detalhe">@(context.Detail ?? (context.TriggersAffected > 0 ? $"{context.TriggersAffected} regra(s)" : ""))</MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Class="mud-text-secondary">Nenhuma mensagem recebida ainda.</MudText>
        </NoRecordsContent>
    </MudTable>
</MudPaper>

<MudText Typo="Typo.caption" Class="mud-text-secondary">
    As credenciais são armazenadas localmente sem criptografia (v1, uso em rede local).
</MudText>

@code {
    private SystemSettings _settings = new();
    private bool _showApiKey;
    private bool _showSecret;
    private bool _registering;
    private string? _webhookError;
    private EvolutionWebhookState? _webhook;
    private IReadOnlyList<WhatsAppCommandLog> _commands = [];

    private EvolutionQr? _qr;
    private string? _pairError;
    private EvolutionConnection? _connection;
    private bool _pairing;
    private DateTime _lastQrAt;
    private CancellationTokenSource? _pollCts;

    protected override async Task OnInitializedAsync()
    {
        _settings = await SettingsRepo.GetSystemSettingsAsync();
        // Rows upgraded before these columns existed come back with 0 / "".
        var defaults = new SystemSettings();
        if (_settings.WhatsAppBotDefaultHours <= 0)
            _settings.WhatsAppBotDefaultHours = defaults.WhatsAppBotDefaultHours;
        if (string.IsNullOrWhiteSpace(_settings.WhatsAppWebhookUrl))
            _settings.WhatsAppWebhookUrl = defaults.WhatsAppWebhookUrl;
        await LoadCommandsAsync();
        if (EvolutionConfigured)
            _ = RefreshConnectionOnLoadAsync();
    }

    private async Task RefreshConnectionOnLoadAsync()
    {
        var state = await Evolution.GetStateAsync(_settings);
        // Errors here (API down, instance not created yet) keep "Não verificado" —
        // the user hasn't asked for anything, so don't alarm them.
        if (state.Connection != EvolutionConnection.Error)
        {
            _connection = state.Connection;
            var webhook = await Evolution.GetWebhookAsync(_settings);
            if (webhook.Error == null)
                _webhook = webhook;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadCommandsAsync() => _commands = await CommandRepo.GetRecentAsync(20);

    private void GenerateSecret()
    {
        _settings.WhatsAppWebhookSecret = Convert.ToBase64String(System.Security.Cryptography.RandomNumberGenerator.GetBytes(24))
            .Replace('+', '-').Replace('/', '_').TrimEnd('=');
        _showSecret = true;
    }

    private async Task RegisterWebhookAsync()
    {
        _registering = true;
        _webhookError = null;
        try
        {
            if (string.IsNullOrWhiteSpace(_settings.WhatsAppWebhookSecret))
                GenerateSecret();
            // The API validates the secret from the same settings row, so save first.
            await SettingsRepo.SaveSystemSettingsAsync(_settings);
            var result = await Evolution.SetWebhookAsync(_settings, _settings.WhatsAppWebhookUrl, _settings.WhatsAppWebhookSecret);
            if (!result.Success)
            {
                _webhookError = result.Error;
                return;
            }
            _webhook = await Evolution.GetWebhookAsync(_settings);
            Snackbar.Add("Webhook registrado na instância.", Severity.Success);
        }
        finally
        {
            _registering = false;
        }
    }

    private (string Label, Color Color) WebhookChip()
    {
        if (_webhook == null)
            return ("Webhook não verificado", Color.Default);
        if (!_webhook.Enabled || string.IsNullOrWhiteSpace(_webhook.Url))
            return ("Webhook não registrado", Color.Warning);
        return string.Equals(_webhook.Url.TrimEnd('/'), _settings.WhatsAppWebhookUrl?.Trim().TrimEnd('/'), StringComparison.OrdinalIgnoreCase)
            ? ("Webhook registrado", Color.Success)
            : ("Webhook aponta para outra URL", Color.Warning);
    }

    private static (string Label, Color Color) StatusChip(WhatsAppCommandStatus status) => status switch
    {
        WhatsAppCommandStatus.Pending => ("Na fila", Color.Default),
        WhatsAppCommandStatus.AwaitingDuration => ("Aguardando prazo", Color.Info),
        WhatsAppCommandStatus.Done => ("Atendida", Color.Success),
        WhatsAppCommandStatus.Ignored => ("Ignorada", Color.Default),
        _ => ("Falhou", Color.Error),
    };

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }

    private bool EvolutionConfigured =>
        Uri.TryCreate(_settings.EvolutionBaseUrl?.Trim(), UriKind.Absolute, out var uri) &&
        uri.Scheme is "http" or "https" &&
        !string.IsNullOrWhiteSpace(_settings.EvolutionInstanceName);

    private async Task SaveAsync()
    {
        await SettingsRepo.SaveSystemSettingsAsync(_settings);
        Snackbar.Add("Configurações salvas.", Severity.Success);
    }

    private Task OpenTestDialogAsync()
    {
        var parameters = new DialogParameters<WhatsAppTestDialog> { { d => d.Settings, _settings } };
        return DialogService.ShowAsync<WhatsAppTestDialog>("Mensagem de teste — WhatsApp", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
    }

    private async Task GenerateQrAsync()
    {
        _pairing = true;
        _pairError = null;
        try
        {
            // An already-paired instance returns no QR — show "connected", not an error.
            // Any state error (e.g. instance not created yet) falls through to connect.
            var state = await Evolution.GetStateAsync(_settings);
            if (state.Connection == EvolutionConnection.Open)
            {
                _connection = EvolutionConnection.Open;
                _qr = null;
                return;
            }

            var qr = await Evolution.ConnectAsync(_settings);
            if (qr.Error != null)
            {
                _pairError = qr.Error;
                _connection = EvolutionConnection.Error;
                return;
            }
            _qr = qr;
            _lastQrAt = DateTime.Now;
            _connection ??= EvolutionConnection.Connecting;
            StartPolling();
        }
        finally
        {
            _pairing = false;
        }
    }

    private void StartPolling()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = new CancellationTokenSource();
        _ = PollStateAsync(_pollCts.Token);
    }

    private async Task PollStateAsync(CancellationToken ct)
    {
        try
        {
            using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
            while (await timer.WaitForNextTickAsync(ct))
            {
                var state = await Evolution.GetStateAsync(_settings, ct);
                _connection = state.Connection;
                _pairError = state.Connection == EvolutionConnection.Error ? state.Error : null;

                if (state.Connection == EvolutionConnection.Open)
                {
                    _qr = null;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                // QR codes expire quickly — refresh while waiting for the scan.
                if (_qr != null && DateTime.Now - _lastQrAt > TimeSpan.FromSeconds(40))
                {
                    var qr = await Evolution.ConnectAsync(_settings, ct);
                    if (qr.Error == null)
                    {
                        _qr = qr;
                        _lastQrAt = DateTime.Now;
                    }
                }

                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
            // page disposed or polling restarted
        }
    }

    private (string Label, Color Color) ConnectionChip() => _connection switch
    {
        EvolutionConnection.Open => ("Conectado", Color.Success),
        EvolutionConnection.Connecting => ("Aguardando leitura do QR", Color.Warning),
        EvolutionConnection.Closed => ("Desconectado", Color.Default),
        EvolutionConnection.Error => ("Erro", Color.Error),
        _ => ("Não verificado", Color.Default),
    };
}
