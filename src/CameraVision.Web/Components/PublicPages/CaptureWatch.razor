@page "/captures/{Id:int}/watch"
@layout Layout.PublicLayout
@using CameraVision.Core.Alerts
@inject ICaptureRepository CaptureRepo
@inject CaptureLinkService Links

@* Public playback page linked from alert e-mails: no sign-in, the ?token= query
   parameter authorizes this single capture (and the media request that follows). *@

<PageTitle>Reprodução — CameraVision</PageTitle>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
}
else if (_capture == null)
{
    <MudAlert Severity="Severity.Warning" Style="max-width: 600px;">
        Link inválido — a captura não está mais disponível.
    </MudAlert>
}
else
{
    <MudPaper Class="pa-4 mx-auto" Style="max-width: 960px;">
        <MudText Typo="Typo.h5" Class="mb-3">Alerta de captura</MudText>

        <video controls autoplay src="@_videoUrl"
               style="width: 100%; max-height: 70vh; background: #000;">
            Seu navegador não suporta a reprodução deste vídeo.
        </video>

        <MudGrid Class="mt-2" Spacing="1">
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Câmera</MudText>
                <MudText Typo="Typo.body1">@_capture.CameraName</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Objeto</MudText>
                <MudText Typo="Typo.body1">@DetectableClasses.Translate(_capture.ObjectClass)</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Início</MudText>
                <MudText Typo="Typo.body1">@_capture.StartedAt.ToString("dd/MM/yyyy HH:mm:ss")</MudText>
            </MudItem>
            <MudItem xs="6" sm="3">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">Duração</MudText>
                <MudText Typo="Typo.body1">@_capture.Duration.ToString(@"mm\:ss")</MudText>
            </MudItem>
        </MudGrid>

        <div class="d-flex gap-2 mt-4">
            <MudButton Variant="Variant.Outlined" Href="@_videoUrl" Target="_blank"
                       StartIcon="@Icons.Material.Filled.Download">Baixar</MudButton>
        </div>
    </MudPaper>
}

@code {
    [Parameter]
    public int Id { get; set; }

    [SupplyParameterFromQuery(Name = "token")]
    public string? Token { get; set; }

    private Capture? _capture;
    private string _videoUrl = "";
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _capture = null;

        if (Links.IsValidToken(Id, Token))
        {
            var capture = await CaptureRepo.GetByIdAsync(Id);
            if (capture != null)
            {
                _capture = capture;
                _videoUrl = Links.MediaUrl(capture.Id, capture.FilePath);
            }
        }

        _loading = false;
    }
}
