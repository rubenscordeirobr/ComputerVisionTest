@inherits LayoutComponentBase

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="Menu" />
        <MudIcon Icon="@Icons.Material.Filled.Videocam" Class="ml-1 mr-2" />
        <MudText Typo="Typo.h6">CameraVision</MudText>
        <MudSpacer />
        <AuthorizeView Context="authContext">
            <Authorized>
                <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mr-1" />
                <MudText Typo="Typo.body2" Class="mr-4">@DisplayNameOf(authContext.User)</MudText>
                <form method="post" action="/logout">
                    <AntiforgeryToken />
                    <MudButton ButtonType="ButtonType.Submit" Color="Color.Inherit" Size="Size.Small"
                               Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Logout">
                        Sair
                    </MudButton>
                </form>
            </Authorized>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="1">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Painel</MudNavLink>
            <MudNavLink Href="/cameras" Icon="@Icons.Material.Filled.Videocam">Câmeras</MudNavLink>
            <MudNavLink Href="/captures" Icon="@Icons.Material.Filled.VideoLibrary">Capturas</MudNavLink>
            <MudNavLink Href="/capture-settings" Icon="@Icons.Material.Filled.Tune">Regras de Captura</MudNavLink>
            <MudNavLink Href="/alerts" Icon="@Icons.Material.Filled.NotificationsActive">Alertas</MudNavLink>
            <MudNavLink Href="/contacts" Icon="@Icons.Material.Filled.Contacts">Contatos</MudNavLink>
            <AuthorizeView Policy="Admin">
                <MudNavLink Href="/users" Icon="@Icons.Material.Filled.People">Usuários</MudNavLink>
            </AuthorizeView>
            <AuthorizeView Policy="SuperAdmin">
                <MudNavLink Href="/tenants" Icon="@Icons.Material.Filled.Business">Clientes</MudNavLink>
                <MudNavGroup Title="Sistema" Icon="@Icons.Material.Filled.Settings" Expanded="true">
                    <MudNavLink Href="/system/smtp" Icon="@Icons.Material.Filled.Email">E-mail (SMTP)</MudNavLink>
                    <MudNavLink Href="/system/application" Icon="@Icons.Material.Filled.Language">Aplicação</MudNavLink>
                    <MudNavLink Href="/system/whatsapp" Icon="@Icons.Material.Filled.Chat">WhatsApp</MudNavLink>
                    <MudNavLink Href="/system/ai" Icon="@Icons.Material.Filled.Psychology">Inteligência artificial</MudNavLink>
                    <MudNavLink Href="/system/suggestions" Icon="@Icons.Material.Filled.Lightbulb">Sugestões do agente</MudNavLink>
                    <MudNavLink Href="/system/alerts" Icon="@Icons.Material.Filled.NotificationImportant">Alertas do sistema</MudNavLink>
                </MudNavGroup>
            </AuthorizeView>
        </MudNavMenu>
    </MudDrawer>
    <MudMainContent Class="mt-16 pa-4">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private static string DisplayNameOf(System.Security.Claims.ClaimsPrincipal user) =>
        user.FindFirst("display_name")?.Value ?? user.Identity?.Name ?? "";
}
