@inject ICaptureRuleRepository RuleRepo
@inject IContactRepository ContactRepo
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            @if (ShowTenantSelect)
            {
                <MudSelect T="int" Value="Rule.TenantId" ValueChanged="OnTenantChangedAsync" Label="Cliente"
                           Class="mb-3" AnchorOrigin="Origin.BottomCenter">
                    @foreach (var tenant in Tenants)
                    {
                        <MudSelectItem T="int" Value="@tenant.Id">@tenant.Name</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudTextField T="string" @bind-Value="Rule.Name" Label="Nome" MaxLength="100"
                          Required="true" RequiredError="Informe o nome da regra." />

            <MudSelect T="string" MultiSelection="true" @bind-SelectedValues="_selectedClasses"
                       Label="Classes monitoradas" AnchorOrigin="Origin.BottomCenter" Class="mt-3"
                       MultiSelectionTextFunc="ClassesSummary">
                @foreach (var name in DetectableClasses.Names)
                {
                    <MudSelectItem T="string" Value="@name">
                        @DetectableClasses.Translate(name) (@name)
                    </MudSelectItem>
                }
            </MudSelect>

            @if (_selectedClasses.Count > 0)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4">Cores na imagem</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Cor da caixa e do rótulo desenhados no vídeo para cada classe. Sem cor definida,
                    o processador usa a cor padrão da classe. Apenas classes com regra são marcadas
                    na imagem.
                </MudText>
                <div class="d-flex flex-wrap gap-3 mt-2">
                    @foreach (var className in _selectedClasses.OrderBy(DetectableClasses.Translate))
                    {
                        var hasColor = Rule.ClassColors.ContainsKey(className);
                        <div class="d-flex align-center gap-2" style="min-width: 220px;">
                            <input type="color" value="@(Rule.ClassColors.GetValueOrDefault(className, DefaultPickerColor))"
                                   @onchange="@(e => SetColor(className, e.Value?.ToString()))"
                                   title="@($"Cor de {DetectableClasses.Translate(className)}")"
                                   style="width: 40px; height: 32px; padding: 0; border: 1px solid var(--mud-palette-lines-inputs); border-radius: 4px; cursor: pointer;" />
                            <div class="d-flex flex-column">
                                <MudText Typo="Typo.body2">@DetectableClasses.Translate(className)</MudText>
                                @if (hasColor)
                                {
                                    <MudLink Typo="Typo.caption" OnClick="@(() => ClearColor(className))">Usar padrão</MudLink>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Cor padrão</MudText>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <MudNumericField T="int" @bind-Value="Rule.MaxSegmentSeconds" Class="mt-3"
                             Label="Duração máxima do segmento (s)" Min="5" Max="3600" />
            <MudNumericField T="double" @bind-Value="Rule.LingerSeconds" Class="mt-3"
                             Label="Tempo de espera após o objeto sair (s)" Min="0" Max="300" Step="0.5" />

            <div class="mt-4">
                <MudText Typo="Typo.body2">
                    Confiança mínima: <b>@(Rule.ConfidenceThreshold.ToString("P0"))</b>
                </MudText>
                <MudSlider T="double" @bind-Value="Rule.ConfidenceThreshold"
                           Min="0.05" Max="0.95" Step="0.05" Color="Color.Primary" />
            </div>

            <MudSwitch T="bool" @bind-Value="_hasWindow" Label="Grava somente em determinado horário"
                       Color="Color.Primary" Class="mt-3" />
            @if (_hasWindow)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="6">
                        <MudTimePicker @bind-Time="_activeFrom" Label="Início" />
                    </MudItem>
                    <MudItem xs="6">
                        <MudTimePicker @bind-Time="_activeTo" Label="Fim" />
                    </MudItem>
                </MudGrid>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Fim menor que o início atravessa a meia-noite (ex.: 22:00 até 06:00). Fora deste
                    horário a regra não grava nem avisa.
                </MudText>
            }

            <MudText Typo="Typo.subtitle2" Class="mt-4">Notificações</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Cada notificação é um canal + contatos + quando avisar. Um contato repetido em várias
                notificações recebe uma única mensagem. As notificações são salvas junto com a regra.
            </MudText>
            <MudTable Items="Rule.Triggers" Dense="true" Elevation="0" Class="mt-1">
                <HeaderContent>
                    <MudTh>Canal</MudTh>
                    <MudTh>Contatos</MudTh>
                    <MudTh>Quando</MudTh>
                    <MudTh>Ativa</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Canal" Style="white-space: nowrap;">
                        <MudIcon Icon="@ChannelUi.Icon(context.Channel)" Color="@ChannelUi.ChannelColor(context.Channel)"
                                 Size="Size.Small" Class="mr-1" />@ChannelUi.Label(context.Channel)
                    </MudTd>
                    <MudTd DataLabel="Contatos">@TriggerText.Contacts(context, _contactsById)</MudTd>
                    <MudTd DataLabel="Quando">
                        @TriggerText.Schedule(context, DateTime.Now)
                        @if (context.Kind == AlertTriggerKind.Temporary && context.IsExpiredAt(DateTime.Now))
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">Expirada</MudChip>
                        }
                    </MudTd>
                    <MudTd DataLabel="Ativa">
                        <MudSwitch T="bool" @bind-Value="context.Enabled" Color="Color.Success" Size="Size.Small" />
                    </MudTd>
                    <MudTd Style="text-align:right; white-space: nowrap;">
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                       OnClick="@(() => EditTriggerAsync(context))" aria-label="Editar" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                       OnClick="@(() => RemoveTrigger(context))" aria-label="Remover" />
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Nenhuma notificação — a regra grava, mas não avisa ninguém.
                    </MudText>
                </NoRecordsContent>
            </MudTable>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="mt-2"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="AddTriggerAsync">
                Adicionar notificação
            </MudButton>

            <MudText Typo="Typo.subtitle2" Class="mt-4">Antiflood</MudText>
            <div class="d-flex align-center flex-wrap gap-4">
                <MudSwitch T="bool" @bind-Value="_grouping" Label="Agrupar notificações" Color="Color.Primary" />
                <MudNumericField T="int" @bind-Value="_windowMinutes" Label="Intervalo do resumo (min)"
                                 Min="1" Max="120" Disabled="@(!_grouping)" Style="max-width: 200px;" />
            </div>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                Com o agrupamento, cada contato recebe no máximo um resumo por intervalo (ex.: pessoas a
                cada 3 min, gatos e cães a cada 30 min). Sem agrupamento, cada captura gera uma mensagem
                imediata.
            </MudText>

            <MudSwitch T="bool" @bind-Value="Rule.Enabled" Label="Regra ativa" Color="Color.Success"
                       Class="mt-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>Edited in place (the page passes a deep clone) — triggers included.</summary>
    [Parameter]
    public CaptureRule Rule { get; set; } = new();

    /// <summary>SuperAdmin editors pick the owning tenant explicitly.</summary>
    [Parameter]
    public bool ShowTenantSelect { get; set; }

    [Parameter]
    public IReadOnlyList<Tenant> Tenants { get; set; } = [];

    private MudForm _form = default!;
    private IReadOnlyCollection<string> _selectedClasses = [];
    private bool _hasWindow;
    private TimeSpan? _activeFrom;
    private TimeSpan? _activeTo;
    private bool _grouping;
    private int _windowMinutes = 3;
    private IReadOnlyList<Contact> _contacts = [];
    private Dictionary<int, Contact> _contactsById = [];

    protected override async Task OnInitializedAsync()
    {
        _selectedClasses = Rule.Classes.ToHashSet(StringComparer.OrdinalIgnoreCase);
        _hasWindow = Rule is { ActiveFrom: not null, ActiveTo: not null };
        _activeFrom = Rule.ActiveFrom?.ToTimeSpan();
        _activeTo = Rule.ActiveTo?.ToTimeSpan();
        _grouping = Rule.GroupWindowMinutes > 0;
        _windowMinutes = _grouping ? Rule.GroupWindowMinutes : 3;
        await LoadContactsAsync();
    }

    private async Task LoadContactsAsync()
    {
        _contacts = Rule.TenantId == 0 ? [] : await ContactRepo.GetAllAsync(Rule.TenantId);
        _contactsById = _contacts.ToDictionary(c => c.Id);
    }

    private async Task OnTenantChangedAsync(int tenantId)
    {
        if (tenantId == Rule.TenantId)
            return;
        Rule.TenantId = tenantId;
        if (Rule.Triggers.Any(t => t.ContactIds.Count > 0))
        {
            foreach (var trigger in Rule.Triggers)
                trigger.ContactIds = [];
            Snackbar.Add("Os contatos das notificações foram limpos: pertencem a outro cliente.", Severity.Warning);
        }
        await LoadContactsAsync();
    }

    private string ClassesSummary(IReadOnlyList<string> selected) =>
        selected.Count == 0 ? "" : string.Join(", ", selected.Select(DetectableClasses.Translate));

    /// <summary>Shown in the picker while the class still uses the worker's default color.</summary>
    private const string DefaultPickerColor = "#FF3838";

    private void SetColor(string className, string? value)
    {
        if (AnnotationColor.TryNormalize(value, out var hex))
            Rule.ClassColors[className] = hex;
    }

    private void ClearColor(string className) => Rule.ClassColors.Remove(className);

    private async Task AddTriggerAsync()
    {
        if (Rule.TenantId == 0)
        {
            Snackbar.Add("Selecione o cliente da regra antes de adicionar notificações.", Severity.Warning);
            return;
        }
        var saved = await OpenTriggerDialogAsync("Nova notificação", new AlertTrigger { CaptureRuleId = Rule.Id });
        if (saved != null)
            Rule.Triggers.Add(saved);
    }

    private async Task EditTriggerAsync(AlertTrigger trigger)
    {
        var saved = await OpenTriggerDialogAsync("Editar notificação", CaptureRuleClones.Clone(trigger));
        if (saved == null)
            return;
        var index = Rule.Triggers.IndexOf(trigger);
        if (index >= 0)
            Rule.Triggers[index] = saved;
    }

    private void RemoveTrigger(AlertTrigger trigger) => Rule.Triggers.Remove(trigger);

    private async Task<AlertTrigger?> OpenTriggerDialogAsync(string title, AlertTrigger trigger)
    {
        var parameters = new DialogParameters<AlertTriggerDialog>
        {
            { d => d.Trigger, trigger },
            { d => d.Contacts, _contacts },
        };
        var dialog = await DialogService.ShowAsync<AlertTriggerDialog>(title, parameters, TriggerDialogOpts);
        var result = await dialog.Result;
        return result is { Canceled: false, Data: AlertTrigger saved } ? saved : null;
    }

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;
        if (Rule.TenantId == 0)
        {
            Snackbar.Add("Selecione o cliente da regra.", Severity.Warning);
            return;
        }
        if (_selectedClasses.Count == 0)
        {
            Snackbar.Add("Selecione ao menos uma classe.", Severity.Warning);
            return;
        }

        if (_hasWindow)
        {
            if (_activeFrom == null || _activeTo == null)
            {
                Snackbar.Add("Informe o horário de início e de fim.", Severity.Warning);
                return;
            }
            if (_activeFrom == _activeTo)
            {
                Snackbar.Add("Início e fim não podem ser iguais.", Severity.Warning);
                return;
            }
            Rule.ActiveFrom = TimeOnly.FromTimeSpan(_activeFrom.Value);
            Rule.ActiveTo = TimeOnly.FromTimeSpan(_activeTo.Value);
        }
        else
        {
            Rule.ActiveFrom = null;
            Rule.ActiveTo = null;
        }

        if (_grouping && _windowMinutes is < 1 or > 120)
        {
            Snackbar.Add("O intervalo do resumo deve ficar entre 1 e 120 minutos.", Severity.Warning);
            return;
        }
        Rule.GroupWindowMinutes = _grouping ? _windowMinutes : 0;

        Rule.Name = Rule.Name.Trim();
        Rule.Classes = _selectedClasses.ToList();
        Rule.ClassColors = AnnotationColor.Sanitize(Rule.ClassColors
            .Where(kv => Rule.Classes.Contains(kv.Key, StringComparer.OrdinalIgnoreCase))
            .Select(kv => new KeyValuePair<string, string?>(kv.Key, kv.Value)));
        foreach (var trigger in Rule.Triggers)
            trigger.CaptureRuleId = Rule.Id;

        if (Rule.Id == 0)
        {
            await RuleRepo.AddAsync(Rule);
            Snackbar.Add("Regra criada.", Severity.Success);
        }
        else
        {
            await RuleRepo.UpdateAsync(Rule);
            await RuleRepo.ReplaceTriggersAsync(Rule.Id, Rule.Triggers);
            Snackbar.Add("Regra atualizada.", Severity.Success);
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();

    private static readonly DialogOptions TriggerDialogOpts = new() { MaxWidth = MaxWidth.Small, FullWidth = true };
}
