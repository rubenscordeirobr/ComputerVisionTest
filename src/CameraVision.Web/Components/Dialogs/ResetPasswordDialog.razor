@using Microsoft.AspNetCore.Identity
@inject IUserRepository UserRepo
@inject IPasswordHasher<AppUser> PasswordHasher
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField T="string" @bind-Value="_password" Label="Nova senha"
                          InputType="InputType.Password" Required="true"
                          RequiredError="Informe a nova senha."
                          Validation="@(new Func<string, string?>(ValidatePassword))" />
            <MudTextField T="string" @bind-Value="_passwordConfirm" Label="Confirmar nova senha" Class="mt-3"
                          InputType="InputType.Password" Required="true"
                          RequiredError="Confirme a nova senha."
                          Validation="@(new Func<string, string?>(ValidatePasswordConfirm))" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Redefinir</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AppUser User { get; set; } = new();

    private MudForm _form = default!;
    private string _password = "";
    private string _passwordConfirm = "";

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        User.PasswordHash = PasswordHasher.HashPassword(User, _password);
        await UserRepo.UpdateAsync(User);
        Snackbar.Add("Senha redefinida.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();

    private string? ValidatePassword(string password) =>
        string.IsNullOrEmpty(password) || password.Length >= 6
            ? null
            : "A senha deve ter pelo menos 6 caracteres.";

    private string? ValidatePasswordConfirm(string confirm) =>
        confirm == _password ? null : "As senhas não coincidem.";
}
