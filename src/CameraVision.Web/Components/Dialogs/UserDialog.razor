@using Microsoft.AspNetCore.Identity
@using CameraVision.Web.Services
@inject IUserRepository UserRepo
@inject IPasswordHasher<AppUser> PasswordHasher
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form">
            <MudTextField T="string" @bind-Value="User.Username" Label="Usuário" MaxLength="64"
                          Required="true" RequiredError="Informe o nome de usuário."
                          Validation="@(new Func<string, Task<string?>>(ValidateUsernameAsync))" />
            <MudTextField T="string" @bind-Value="User.DisplayName" Label="Nome de exibição"
                          MaxLength="100" Class="mt-3" />
            @if (IsNew)
            {
                <MudTextField T="string" @bind-Value="_password" Label="Senha" Class="mt-3"
                              InputType="InputType.Password" Required="true"
                              RequiredError="Informe a senha."
                              Validation="@(new Func<string, string?>(ValidatePassword))" />
                <MudTextField T="string" @bind-Value="_passwordConfirm" Label="Confirmar senha" Class="mt-3"
                              InputType="InputType.Password" Required="true"
                              RequiredError="Confirme a senha."
                              Validation="@(new Func<string, string?>(ValidatePasswordConfirm))" />
            }
            <MudSelect T="UserRole" @bind-Value="User.Role" Label="Perfil" Class="mt-3"
                       AnchorOrigin="Origin.BottomCenter">
                <MudSelectItem T="UserRole" Value="UserRole.User">@RoleUi.Label(UserRole.User)</MudSelectItem>
                <MudSelectItem T="UserRole" Value="UserRole.Admin">@RoleUi.Label(UserRole.Admin)</MudSelectItem>
                @if (EditorIsSuperAdmin)
                {
                    <MudSelectItem T="UserRole" Value="UserRole.SuperAdmin">@RoleUi.Label(UserRole.SuperAdmin)</MudSelectItem>
                }
            </MudSelect>
            @if (EditorIsSuperAdmin)
            {
                @if (User.Role == UserRole.SuperAdmin)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                        Superadmins não pertencem a nenhum cliente.
                    </MudText>
                }
                else
                {
                    <MudSelect T="int?" @bind-Value="User.TenantId" Label="Cliente" Class="mt-3"
                               AnchorOrigin="Origin.BottomCenter">
                        @foreach (var tenant in Tenants)
                        {
                            <MudSelectItem T="int?" Value="@((int?)tenant.Id)">@tenant.Name</MudSelectItem>
                        }
                    </MudSelect>
                }
            }
            <MudSwitch T="bool" @bind-Value="User.IsActive" Label="Ativo"
                       Color="Color.Success" Class="mt-3" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">Salvar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter]
    public AppUser User { get; set; } = new();

    [Parameter]
    public bool IsNew { get; set; }

    [Parameter]
    public int CurrentUserId { get; set; }

    /// <summary>SuperAdmin editors pick tenant + any role; tenant admins stay inside their tenant.</summary>
    [Parameter]
    public bool EditorIsSuperAdmin { get; set; }

    [Parameter]
    public int? EditorTenantId { get; set; }

    [Parameter]
    public IReadOnlyList<Tenant> Tenants { get; set; } = [];

    private MudForm _form = default!;
    private string _password = "";
    private string _passwordConfirm = "";

    private async Task SaveAsync()
    {
        await _form.ValidateAsync();
        if (!_form.IsValid)
            return;

        // Tenant assignment: superadmins have none; everyone else needs one. A
        // tenant admin can only ever create/edit users of their own tenant.
        if (User.Role == UserRole.SuperAdmin)
            User.TenantId = null;
        else if (!EditorIsSuperAdmin)
            User.TenantId = EditorTenantId;
        if (User.Role != UserRole.SuperAdmin && User.TenantId == null)
        {
            Snackbar.Add("Selecione o cliente do usuário.", Severity.Warning);
            return;
        }

        if (!IsNew && User.Id == CurrentUserId)
        {
            var requiredRole = EditorIsSuperAdmin ? UserRole.SuperAdmin : UserRole.Admin;
            if (User.Role != requiredRole)
            {
                Snackbar.Add("Você não pode alterar seu próprio perfil.", Severity.Warning);
                return;
            }
            if (!User.IsActive)
            {
                Snackbar.Add("Você não pode desativar seu próprio usuário.", Severity.Warning);
                return;
            }
        }

        User.Username = User.Username.Trim();
        User.DisplayName = string.IsNullOrWhiteSpace(User.DisplayName) ? null : User.DisplayName.Trim();

        if (IsNew)
        {
            User.PasswordHash = PasswordHasher.HashPassword(User, _password);
            await UserRepo.AddAsync(User);
            Snackbar.Add("Usuário criado.", Severity.Success);
        }
        else
        {
            await UserRepo.UpdateAsync(User);
            Snackbar.Add("Usuário atualizado.", Severity.Success);
        }
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task<string?> ValidateUsernameAsync(string username)
    {
        if (string.IsNullOrWhiteSpace(username))
            return null;
        var exists = await UserRepo.UsernameExistsAsync(username.Trim(), IsNew ? null : User.Id);
        return exists ? "Já existe um usuário com esse nome." : null;
    }

    private string? ValidatePassword(string password) =>
        string.IsNullOrEmpty(password) || password.Length >= 6
            ? null
            : "A senha deve ter pelo menos 6 caracteres.";

    private string? ValidatePasswordConfirm(string confirm) =>
        confirm == _password ? null : "As senhas não coincidem.";
}
