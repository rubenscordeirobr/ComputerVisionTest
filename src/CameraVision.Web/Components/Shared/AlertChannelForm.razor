@inject ISettingsRepository SettingsRepo
@inject ISnackbar Snackbar

@if (Channel == AlertChannel.Email)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Interruptor geral do canal de e-mail (requer SMTP configurado em <b>Sistema</b>).
        Quem recebe é definido pelos <MudLink Href="/contacts">Contatos</MudLink>: cada regra
        escolhe quais contatos avisar e quando, e os alertas de saúde das câmeras vão para os
        contatos marcados com "Recebe alertas de saúde das câmeras".
    </MudAlert>
}
else
{
    <MudAlert Severity="Severity.Info" Class="mb-4">
        Interruptor geral do canal de WhatsApp (requer a Evolution API configurada e o número
        pareado em <b>Sistema</b>). Quem recebe é definido pelos
        <MudLink Href="/contacts">Contatos</MudLink>: cada regra escolhe quais contatos avisar e
        quando, e os alertas de saúde das câmeras vão para os contatos marcados com "Recebe
        alertas de saúde das câmeras".
    </MudAlert>
}

<MudSwitch T="bool" @bind-Value="_settings.Enabled" Label="Ativado" Color="Color.Success" />
<MudText Typo="Typo.caption" Class="mud-text-secondary">
    Desligado, nenhuma notificação sai por este canal — nem as das regras nem as de saúde das câmeras.
</MudText>

<MudText Typo="Typo.body2" Class="mud-text-secondary mt-4">
    Quem é avisado por cada regra (e em quais dias e horários) é definido em
    <MudLink Href="/capture-settings">Regras de Captura</MudLink> → Notificações.
</MudText>

<div class="d-flex justify-end mt-6">
    <MudButton Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save" OnClick="SaveAsync">
        Salvar
    </MudButton>
</div>

@code {
    [Parameter, EditorRequired]
    public AlertChannel Channel { get; set; }

    /// <summary>The switch belongs to a tenant (the SuperAdmin picks one on the page).</summary>
    [Parameter, EditorRequired]
    public int TenantId { get; set; }

    private AlertSettings _settings = new();
    private int _loadedTenantId = -1;

    protected override async Task OnParametersSetAsync()
    {
        if (TenantId == _loadedTenantId)
            return;
        _loadedTenantId = TenantId;
        _settings = await SettingsRepo.GetAlertSettingsAsync(TenantId, Channel);
    }

    private async Task SaveAsync()
    {
        await SettingsRepo.SaveAlertSettingsAsync(_settings);
        Snackbar.Add("Configurações de alerta salvas.", Severity.Success);
    }
}
